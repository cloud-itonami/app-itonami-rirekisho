{:paths ["src"]
 ;; 意図的に依存ゼロ。この repo が持つのは値モデルと不変条件だけで、暗号 provider・
 ;; store・identity は呼び出し側が注入する(`rirekisho.envelope` の seal-fn/open-fn)。
 ;; ブラウザでは kagi.crypto.noble、JVM では kagi.crypto/jvm-provider を渡す。
 ;; 依存を持たないので .cljc がそのまま両 runtime で走る。
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       }
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; TEST-ONLY. `rirekisho.provenance` は依存ゼロのまま
                      ;; （CBOR も署名器も注入する）だが、「nekko.sigref と
                      ;; バイト互換」は主張ではなく検証したい。本物の nekko と
                      ;; ed25519 をここだけで引いて、両方向を通す。
                      ;;
                      ;; 実行時に依存しないのは nekko.sigref が ed25519.core に
                      ;; 直接依存しており、その ns が今日 JVM 専用だから
                      ;; （nekko 自身の docstring がそう書いている）。依存すると
                      ;; この repo のブラウザ側が丸ごと動かなくなる。
                      io.github.kotoba-lang/kotoba-rad
                      {:git/url "https://github.com/kotoba-lang/kotoba-rad.git"
                       :git/sha "a89db47d180b1f22375ad1a5d7ea0c438638d110"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
